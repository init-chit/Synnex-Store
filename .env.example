# PostgreSQL
DB_DATABASE=synnex_store
DB_USER=postgres
DB_PASSWORD=change-me

# Backend
JWT_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Frontend build-time API URL
VITE_API_URL=http://localhost:5000

# Initial admin bootstrap
# The backend startup script reads these values and synchronizes the admin
# account on startup. Replace the password before using this in production.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@synnex.store
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
