DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=synnex_store
DB_PASSWORD=change-me
DB_PORT=5432
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost

# Optional initial admin bootstrap. Replace the password before use.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@synnex.store
INITIAL_ADMIN_PASSWORD=replace-with-an-8-to-16-character-password
# After the first successful bootstrap, remove or unset these values if you do
# not want startup to synchronize the administrator on every restart.
