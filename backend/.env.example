DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=synnex_store
DB_PASSWORD=change-me
DB_PORT=5432
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost

# Optional one-time initial admin bootstrap. Keep real credentials out of Git.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars
# After the first successful bootstrap, remove or unset these values.
