DB_HOST=db
DB_PORT=5432
DB_NAME=synnex_store
DB_USER=postgres
DB_PASSWORD=change-me
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Optional one-time bootstrap for the first admin account.
# Keep these values out of Git and your Docker image.
# Remove/unset them after the first successful bootstrap.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars
